# Google Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Embedding Configuration: 'gemini' (requires GEMINI_API_KEY) or 'local' (zero-cost, offline fallback)
EMBEDDING_MODE=local

# Top-K chunks to retrieve from Vector Database
TOP_K=5

# Gemini Model name
GEMINI_MODEL=gemini-2.5-flash

# Flask Server Port
PORT=5000
DEBUG=True
